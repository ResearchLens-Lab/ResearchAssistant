{
  "name": "researchlens-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Private local ResearchLens Windows desktop app",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build": "node scripts/build.mjs",
    "build:web": "node scripts/build.mjs --web-only",
    "package:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.researchlens.desktop",
    "productName": "ResearchLens",
    "compression": "normal",
    "asar": true,
    "files": [
      "main.cjs",
      "preload.cjs",
      "onboarding/**/*",
      "startup/**/*",
      "build/icon.ico",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/app-runtime",
        "to": "app-runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "../release/desktop"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ResearchLens-Setup-x64.exe",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "include": "build/installer.nsh"
    }
  },
  "allowScripts": {
    "electron@39.8.10": true,
    "electron-winstaller@5.4.0": true
  }
}
