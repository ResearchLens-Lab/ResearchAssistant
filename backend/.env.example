APP_ENV=development
APP_NAME=ResearchAssistant

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/researchassistant

JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:3000

RAG_SERVICE_URL=
RAG_TIMEOUT_SECONDS=60
RAG_INGEST_TIMEOUT_SECONDS=600

KNOWLEDGE_GRAPH_URL=

UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=100
MAX_UPLOAD_BATCH_SIZE_MB=500
MAX_UPLOAD_BATCH_FILES=100
MAX_ZIP_ENTRIES=100
MAX_ZIP_ENTRY_SIZE_MB=100
MAX_ZIP_EXPANDED_SIZE_MB=100
MAX_ZIP_COMPRESSION_RATIO=200
RAG_COLLECTION_NAME=research_papers
GEMINI_API_KEY=
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=64
# Persistent local vector cache; blank uses CHROMA_PERSIST_DIR/embedding_cache.sqlite3
EMBEDDING_CACHE_PATH=
FASTEMBED_CACHE_DIR=.model_cache
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
LLM_TIMEOUT_SECONDS=30
LLM_DAILY_CALL_BUDGET=25
# Budget uses UTC calendar days (resets at 00:00 UTC).

# Mock providers are intended for automated tests only. Configure GEMINI_API_KEY
# in the root .env (or rag/.env) for local real-model use.
