APP_ENV=development
APP_NAME=ResearchAssistant

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/researchassistant

JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:3000

RAG_SERVICE_URL=
RAG_TIMEOUT_SECONDS=60

KNOWLEDGE_GRAPH_URL=

UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=25
RAG_COLLECTION_NAME=research_papers
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=mock-dense-384
EMBEDDING_DIMENSION=384
EMBEDDING_API_KEY=
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30

# For real RAG providers, configure the repository-root .env (or rag/.env):
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSION=1536
# EMBEDDING_API_KEY=replace-with-your-key
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=replace-with-your-key
