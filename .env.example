# ==================================================
# ResearchLens RAG & AI Configuration
# ==================================================

# Environment (development, testing, production)
APP_ENV=development

# ChromaDB Settings
CHROMA_PERSIST_DIR=.chroma
CHROMA_COLLECTION_NAME=research_papers
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_USE_HTTP=false

# Embedding Configuration
# Providers: fastembed (local default), gemini (optional), or mock (automated tests only)
GEMINI_API_KEY=
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=64
EMBEDDING_CACHE_PATH=
FASTEMBED_CACHE_DIR=.model_cache

# LLM Generation Configuration
# Local Qwen synthesis (no cloud inference). Ollama must already have this model installed.
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:0.8b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:0.8b
RAG_ANSWER_MODE=LOCAL_QWEN
# `independent` uses only local SQLite FTS5 + deterministic TF-IDF/rules/templates.
# It never calls Qwen, another generative provider, or a pretrained embedder.
# Change this to `independent` to enable Phase 1; `legacy` keeps the prior hybrid path.
RAG_ENGINE_MODE=legacy
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=512
LLM_TIMEOUT_SECONDS=180
LLM_DAILY_CALL_BUDGET=25
# Budget uses UTC calendar days (resets at 00:00 UTC).
# Optional extra LLM call(s) for bounded claim-to-evidence judgments. Default off.
CLAIM_VERIFICATION_USE_LLM=false

# Chunking Configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# Retrieval & Context Configuration
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.0
CONTEXT_MAX_TOKENS=3000
RAG_TIMEOUT_SECONDS=240
